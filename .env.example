# AlanSM Solutions - Environment Variables

# Server-side Gemini API Key (Secret)
GEMINI_API_KEY=

# Client-side Google Apps Script URL for Lead Capture
VITE_CONTACT_API_URL=

# Client-side WhatsApp Number (International format without +)
VITE_WHATSAPP_NUMBER=

# Port configuration (Render uses 3000 by default)
PORT=3000
